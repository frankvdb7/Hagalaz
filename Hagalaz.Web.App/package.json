{
    "name": "hagalaz.web.app",
    "version": "1.0.0",
    "license": "MIT",
    "type": "module",
    "main": "dist-launcher/main.js",
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve Hagalaz.Web.App",
        "start:aspire": "ng serve Hagalaz.Web.App --port %PORT%",
        "build": "ng build Hagalaz.Web.App --base-href ./",
        "test": "ng test Hagalaz.Web.App --watch=false",
        "lint": "pnpm run lint:biome",
        "lint:biome": "biome lint .",
        "fallow:audit": "fallow audit",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "launcher:serve": "ng serve Hagalaz.Web.App --configuration=launcher-development",
        "launcher:build": "ng build Hagalaz.Web.App --subresource-integrity --configuration=production,launcher-production",
        "launcher:bundle:main": "esbuild src/launcher/main.ts --bundle --platform=node --target=node22.9 --external:electron* --tsconfig=tsconfig.launcher.json --outdir=dist-launcher",
        "launcher:bundle:preload": "esbuild src/launcher/preload.ts --bundle --platform=node --target=node22.9 --external:electron* --tsconfig=tsconfig.launcher.preload.json --outfile=dist-launcher/preload.js",
        "launcher:start": "npm run launcher:bundle:main && npm run launcher:bundle:preload && electron-forge start --enable-logging --app-path dist-launcher/main.js",
        "start:aspire:admin": "ng serve Hagalaz.Web.Admin --port %PORT%",
        "admin:serve": "ng serve Hagalaz.Web.Admin --configuration=development",
        "admin:build": "ng build Hagalaz.Web.Admin --configuration=production --base-href ./",
        "admin:test": "ng test Hagalaz.Web.Admin --watch=false",
        "admin:test:coverage": "ng test Hagalaz.Web.Admin --watch=false --coverage"
    },
    "private": true,
    "dependencies": {
        "@angular/cdk": "^22.2.4",
        "@angular/common": "^22.2.3",
        "@angular/compiler": "^22.2.3",
        "@angular/core": "^22.2.3",
        "@angular/forms": "^22.2.3",
        "@angular/material": "^22.2.4",
        "@angular/platform-browser": "^22.2.3",
        "@angular/platform-browser-dynamic": "^22.2.3",
        "@angular/router": "^22.2.3",
        "@angular/service-worker": "^22.2.3",
        "@ngrx/operators": "^22.0.1",
        "@ngrx/signals": "^22.0.1",
        "@ngx-loading-bar/core": "^7.0.1",
        "@ngx-loading-bar/http-client": "^7.0.1",
        "@ngx-loading-bar/router": "^7.0.1",
        "angular-svg-icon": "^19.1.1",
        "electron-squirrel-startup": "^1.0.1",
        "inversify": "^8.2.3",
        "marked": "^18.1.1",
        "ng-hcaptcha": "^2.8.0",
        "overlayscrollbars": "^2.17.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "tslib": "^2.8.1",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@angular/build": "^22.2.3",
        "@angular/cli": "^22.2.3",
        "@angular/compiler-cli": "^22.2.3",
        "@angular/language-service": "^22.2.3",
        "@biomejs/biome": "^2.6.2",
        "@electron-forge/cli": "^8.0.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "5.0.5",
        "electron": "^45.0.0",
        "esbuild": "^0.28.2",
        "fallow": "^3.34.1",
        "jsdom": "^30.1.3",
        "postcss": "^8.5.31",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "vitest": "^5.0.5"
    },
    "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
